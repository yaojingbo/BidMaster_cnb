{
  "name": "@bid-master/rag-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "npm run build && node --watch dist/src/server.js",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test dist/test/*.test.js",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config drizzle.config.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "@ai-sdk/openai": "4.0.43",
    "@mastra/core": "1.59.0",
    "@mastra/rag": "2.5.0",
    "@zilliz/milvus2-sdk-node": "3.0.4",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0",
    "zod": "4.4.3"
  }
}
