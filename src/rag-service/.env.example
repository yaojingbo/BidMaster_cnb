# rag-service 独立进程所需环境变量（复制为 .env 后填真实值，勿提交 .env）
# 参考根目录 .env.local / .env.example 中的 Zilliz 与 DashScope 凭据

# 与 FastAPI RAG_INTERNAL_TOKEN 保持一致（32+ 字符）
RAG_INTERNAL_TOKEN=

# Zilliz Cloud（REST）
ZILLIZ_URI=
ZILLIZ_USERNAME=
ZILLIZ_PASSWORD=
ZILLIZ_TRANSPORT=rest

# 阿里云百炼 DashScope
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_BASE_URL=https://llm-frgbb5dwa2nkvchb.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
RAG_EMBEDDING_MODEL=text-embedding-v4
RAG_EMBEDDING_DIMENSION=1024
RAG_INDEX_VERSION=v3-text-embedding-v4
RAG_VECTOR_COLLECTION=bidmaster_rag_chunks
RAG_LLM_MODEL=qwen-plus

# 预索引文档目录（MVP：仓库根 data/ 的绝对路径）
RAG_DATA_DIR=
