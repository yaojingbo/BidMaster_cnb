# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bidmaster

# LLM Providers (API Keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
# 北京地域百炼业务空间专属 OpenAI 兼容地址，例如：
# https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_EMBEDDING_BASE_URL=https://YOUR_WORKSPACE_ID.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
ZHIPU_API_KEY=your-zhipu-key
MINIMAX_API_KEY=your-minimax-key
OPENAI_API_KEY=sk-your-openai-key
CLAUDE_API_KEY=your-claude-key

# Ollama (optional, for local)
OLLAMA_BASE_URL=http://localhost:11434

# Knowledge Base / RAG
KNOWLEDGE_BASE_ENABLED=true
RAG_REQUIRED=false
# 独立 Node.js/Mastra RAG 服务。令牌至少 32 字符，只能存在服务端环境中。
RAG_SERVICE_ENABLED=false
RAG_SERVICE_URL=http://127.0.0.1:8100
RAG_INTERNAL_TOKEN=replace-with-at-least-32-random-characters
RAG_SERVICE_TIMEOUT_SECONDS=30
# RAG 服务数据库与派生向量索引配置
RAG_DATABASE_URL=postgresql://user:password@neon-host/bidmaster?sslmode=require
RAG_EMBEDDING_PROVIDER=dashscope
RAG_EMBEDDING_MODEL=qwen3-vl-embedding
# 必须通过真实北京地域 smoke 后填写，禁止沿用旧实现的 1024。
RAG_EMBEDDING_DIMENSION=
RAG_INDEX_VERSION=v3-qwen3-vl-embedding
RAG_VECTOR_COLLECTION=bidmaster_rag_chunks
ZILLIZ_ADDRESS=https://your-zilliz-endpoint
ZILLIZ_TOKEN=your-zilliz-token
RAG_EMBEDDING_BATCH_SIZE=10
RAG_EMBEDDING_BATCH_MAX_TOKENS=8192
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=160
RAG_MIN_CHUNK_CHARS=80
RAG_VECTOR_TOP_K=30
RAG_KEYWORD_TOP_K=20
RAG_CONTEXT_K=8
RAG_RRF_K=60
RAG_CHUNKING_VERSION=v1
RAG_INDEX_CONCURRENCY=2
RAG_TASK_STALE_SECONDS=900

# Encryption
FERNET_KEY=your-32-byte-base64-encoded-key

# Runtime environment
BID_MASTER_ENV=development

# 游客模式（只读演示）：未登录用户可只读浏览功能页并查看预置演示数据，
# 写操作（上传/提取/模拟/开标分析/知识库问答）与 AI 调用仍需登录。
# 后端与前端需同时开启；默认关闭。开启后重启后端会自动为 guest-demo 写入演示数据。
# GUEST_MODE=true
# NEXT_PUBLIC_GUEST_MODE=true

# Backend URL used by Next.js API Routes and rewrites.
BACKEND_URL=http://localhost:8000

# Frontend business API direct connection.
# 仅在本地开发需要前端全部直连后端时设置；生产环境默认通过同源 API 访问。
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Frontend — 不建议生产环境设置此变量；它会让所有 API 包括认证相关调用倾向外部地址。
# 仅在本地开发需要前端全部直连后端时设置：NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS / OCR
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
PADDLEOCR_HOME=/data/paddleocr
OCR_SAVE_EVIDENCE=false
OCR_EVIDENCE_DIR=/data/ocr-evidence

# CNB Git 凭据（仅本地手动推分支时需要；CI/CD 流水线用平台内置身份，不需要这里的值）
# 权限只需 read_repository。禁止把真实值提交进仓库；令牌作废与重建见
# docs/deployment/credential-rotation-runbook.md 第 3 节。
# CNB_GIT_USERNAME=<CNB 用户名>
# CNB_GIT_TOKEN=<只读访问令牌>
