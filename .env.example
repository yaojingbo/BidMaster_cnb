# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bidmaster

# LLM Providers (API Keys)
DEEPSEEK_API_KEY=sk-your-deepseek-key
DASHSCOPE_API_KEY=sk-your-dashscope-key
ZHIPU_API_KEY=your-zhipu-key
MINIMAX_API_KEY=your-minimax-key
OPENAI_API_KEY=sk-your-openai-key
CLAUDE_API_KEY=your-claude-key

# Ollama (optional, for local)
OLLAMA_BASE_URL=http://localhost:11434

# Knowledge base (local FastEmbed + Neon pgvector)
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
KNOWLEDGE_EMBEDDING_CACHE_DIR=./models/fastembed
KNOWLEDGE_CHUNK_SIZE=800
KNOWLEDGE_CHUNK_OVERLAP=120
KNOWLEDGE_EMBEDDING_BATCH_SIZE=32
KNOWLEDGE_SEARCH_TOP_K=8
KNOWLEDGE_SEARCH_MIN_SCORE=0.35

# Encryption
FERNET_KEY=your-32-byte-base64-encoded-key

# Runtime environment
BID_MASTER_ENV=development

# Backend URL used by Next.js API Routes and rewrites.
BACKEND_URL=http://localhost:8000

# Frontend business API direct connection.
# 仅在本地开发需要前端全部直连后端时设置；生产环境默认通过同源 API 访问。
# NEXT_PUBLIC_BACKEND_API_URL=http://localhost:8000

# Frontend — 不建议生产环境设置此变量；它会让所有 API 包括认证相关调用倾向外部地址。
# 仅在本地开发需要前端全部直连后端时设置：NEXT_PUBLIC_API_URL=http://localhost:8000
# NEXT_PUBLIC_API_URL=http://localhost:8000

# Backend CORS / OCR
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
PADDLEOCR_HOME=/data/paddleocr
OCR_SAVE_EVIDENCE=false
OCR_EVIDENCE_DIR=/data/ocr-evidence
